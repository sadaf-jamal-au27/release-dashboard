PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated list of repos to read runs from
GITHUB_REPOS=your-org/your-repo,another-org/another-repo

# Which branch to filter workflow runs by
GITHUB_BRANCH=main

# How many recent runs to fetch per repo
GITHUB_RUNS_PER_REPO=1

# GitHub App authentication
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678

# Provide ONE of these:
# Option A: PEM (escape newlines as \n)
GITHUB_APP_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Option B: base64-encoded PEM
# GITHUB_APP_PRIVATE_KEY_BASE64=...

